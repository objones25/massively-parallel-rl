# mprl configuration. scripts/setup.sh asks for each value and writes .env (mode 0600, gitignored)
# in the repo root. Keys ending in _KEY or _TOKEN are read without echo.

# W&B API key: https://wandb.ai/authorize
WANDB_API_KEY=

# W&B entity (your username or team) that owns the project; empty uses the key's default entity
WANDB_ENTITY=

# W&B project every run logs to (created on first use)
WANDB_PROJECT=mprl-humanoid-walk

# Hugging Face access token with write access: https://huggingface.co/settings/tokens
HF_TOKEN=

# Hugging Face model repo for weights and results, as <user>/<name>; created private if absent
HF_REPO_ID=

# RunPod API key, used only to terminate this pod when training ends: RunPod console, Settings, API Keys
RUNPOD_API_KEY=

# Checkpoints and results root; must be on the RunPod network volume (mounted at /workspace)
MPRL_VOLUME_ROOT=/workspace/mprl
