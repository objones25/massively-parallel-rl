.env
.superpowers/
# .venv is a symlink to .venv.nosync: iCloud "Desktop & Documents" skips *.nosync, so the
# environment is never evicted to cloud placeholders.
.venv
.venv.nosync/
.venv-icloud-old/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
logs/
wandb/
.DS_Store
# Reference PDFs stay local (large; one is the user's own survey).
*.pdf
coverage.xml
